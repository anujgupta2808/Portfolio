# Server Port
PORT=5000

# Client Origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Supabase Credentials (Optional for production database storage)
# If left empty or placeholder, server uses local persistent backup store
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
